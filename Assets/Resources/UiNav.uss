/* Shared by every menu (UiNav.Register adds it to their roots): the controller focus outline, controller-only hints
   and the page controls (Pager). nav--gamepad is on a menu's root while a controller is used last. */

/* A player's controller focus (PlayerNav: two classes each, so it wins over a list's own selected style); player 2's
   is blue */
.nav-focus-p1.nav--focused-p1 {
    border-color: #E0A020;
    background-color: rgba(224, 160, 32, 0.25);
    scale: 1.04 1.04;
}

.nav-focus-p2.nav--focused-p2 {
    border-color: #40A8F0;
    background-color: rgba(64, 168, 240, 0.25);
    scale: 1.04 1.04;
}

/* Only with a controller / only with the mouse and keyboard */
.nav-hint {
    display: none;
    font-size: 12px;
    color: #A8ADB8;
    -unity-text-align: middle-center;
    margin-top: 8px;
}

.nav--gamepad .nav-hint {
    display: flex;
}

.nav--gamepad .nav-mouse-only {
    display: none;
}

/* Pages: "‹ 2 / 3 ›" under a list */
.pager {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-top: 6px;
    flex-shrink: 0;
}

.pager__arrow {
    font-size: 18px;
    -unity-font-style: bold;
    color: #F2F2F2;
    padding: 0 10px;
}

.pager__arrow:hover {
    color: #E0A020;
}

.pager__arrow--disabled {
    color: #4A4F5B;
}

.pager__arrow--disabled:hover {
    color: #4A4F5B;
}

.pager__label {
    font-size: 13px;
    color: #A8ADB8;
    min-width: 50px;
    -unity-text-align: middle-center;
}

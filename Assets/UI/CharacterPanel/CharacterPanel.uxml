<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="CharacterPanel.uss" />
    <ui:VisualElement name="characterPanelRoot" class="character-panel-root character-panel-root--hidden" picking-mode="Ignore">
        <ui:VisualElement name="panel" class="character-panel">
            <ui:VisualElement class="cp-equipment">
                <ui:Label text="Character" class="cp-title" />
                <ui:Label name="header" class="cp-header" />
                <!-- Slots are created by CharacterPanelHUD -->
                <ui:VisualElement name="slotGrid" class="cp-slot-grid" />
                <ui:Label name="hint" text="Click a slot to swap · Press I to close" class="cp-hint" />
            </ui:VisualElement>
            <ui:VisualElement class="cp-stats-column">
                <!-- Shown while the swap picker is open -->
                <ui:VisualElement name="previewHeader" class="cp-preview cp-preview--hidden">
                    <ui:Label name="previewTitle" class="cp-preview__title" />
                    <ui:Label text="Legendary powers and passives aren't counted in the numbers" class="cp-preview__note" />
                </ui:VisualElement>
                <!-- Stat sections and rows are created by CharacterPanelHUD -->
                <ui:VisualElement name="statList" class="cp-stats" />
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- Swap picker, placed left of the panel by CharacterPanelHUD; chips and options are created there -->
        <ui:VisualElement name="picker" class="cp-picker cp-picker--hidden">
            <ui:Label name="pickerTitle" class="cp-picker__title" />
            <ui:VisualElement name="pickerFilters" class="cp-picker__filters" />
            <ui:VisualElement name="pickerList" class="cp-picker__list" />
        </ui:VisualElement>
        <ui:VisualElement name="tooltip" class="cp-tooltip" picking-mode="Ignore">
            <ui:Label name="tooltipTitle" class="cp-tooltip__title" picking-mode="Ignore" />
            <ui:Label name="tooltipSubtitle" class="cp-tooltip__subtitle" picking-mode="Ignore" />
            <ui:VisualElement name="tooltipBody" class="cp-tooltip__body" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

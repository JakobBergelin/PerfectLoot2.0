/* Variables and font on the HUD's own root so everything inherits them */
.portal-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    --panel-bg: rgba(20, 22, 28, 0.95);
    --panel-border: #3A3F4B;
    --text-color: #F2F2F2;
    --accent: #E0A020;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/LiberationSans.ttf");
}

/* left/top are set from code to the point above the portal; the card is centered on it and sits above it */
.portal-card {
    position: absolute;
    translate: -50% -100%;
    align-items: center;
    padding: 10px 14px;
    background-color: var(--panel-bg);
    border-width: 2px;
    border-color: var(--panel-border);
    border-radius: 8px;
}

.portal-card--hidden {
    display: none;
}

.portal-name {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--accent);
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0 0 8px 0;
}

/* Who is ready, in co-op (PortalHUD) */
.portal-status {
    font-size: 13px;
    color: var(--text-color);
    -unity-text-align: middle-center;
    padding: 0;
    margin: -4px 0 8px 0;
}

/* A dungeon's difficulty, between the arrows the host's player 1 picks it with */
.portal-difficulty {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin: -4px 0 8px 0;
}

.portal-difficulty__label {
    min-width: 96px;
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--text-color);
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0 6px;
}

.portal-arrow {
    width: 26px;
    height: 24px;
    margin: 0;
    padding: 0;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--text-color);
    background-color: rgba(42, 46, 56, 0.9);
    border-width: 1px;
    border-color: #4A5060;
    border-radius: 5px;
}

.portal-arrow:hover {
    background-color: #383D4A;
}

.portal-arrow:disabled {
    opacity: 0.35;
}

.portal-button {
    min-width: 120px;
    height: 34px;
    margin: 0;
    padding: 0 14px;
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: #1A1A1A;
    background-color: var(--accent);
    border-width: 2px;
    border-color: #F0C050;
    border-radius: 6px;
}

.portal-button:hover {
    background-color: #F0B030;
}

.portal-button:active {
    background-color: #B88010;
}

/* The leaderboard, under Enter */
.portal-button--quiet {
    height: 26px;
    margin-top: 6px;
    font-size: 13px;
    -unity-font-style: normal;
    color: var(--text-color);
    background-color: rgba(42, 46, 56, 0.9);
    border-width: 1px;
    border-color: #4A5060;
}

.portal-button--quiet:hover {
    background-color: #383D4A;
}

.portal-button--quiet:active {
    background-color: #2A2E38;
}

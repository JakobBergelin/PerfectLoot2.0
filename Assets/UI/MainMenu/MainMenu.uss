/* Variables and font on the menu's own root so everything inherits them */
.main-menu-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: #0D0E12;
    --panel-bg: rgba(20, 22, 28, 0.95);
    --panel-border: #3A3F4B;
    --card-bg: rgba(10, 11, 14, 0.9);
    --card-bg-hover: rgba(40, 44, 54, 0.95);
    --card-border: #3A3F4B;
    --text-color: #F2F2F2;
    --text-muted: #A8ADB8;
    --accent: #E0A020;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/LiberationSans.ttf");
}

.mm-screen--hidden {
    display: none;
}

.mm-title {
    font-size: 56px;
    -unity-font-style: bold;
    color: var(--accent);
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0 0 32px 0;
}

.mm-panel {
    width: 380px;
    padding: 20px;
    background-color: var(--panel-bg);
    border-width: 2px;
    border-color: var(--panel-border);
    border-radius: 8px;
}

.mm-heading {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--text-color);
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0 0 14px 0;
}

.mm-hint {
    font-size: 12px;
    color: var(--text-muted);
    -unity-text-align: middle-center;
    white-space: normal;
    padding: 0;
    margin: 8px 0 4px 0;
}

/* Name field */
.mm-name-field {
    margin: 0;
    padding: 0;
    --unity-cursor-color: #F2F2F2;
    --unity-selection-color: rgba(224, 160, 32, 0.5);
}

.mm-name-field .unity-base-text-field__input {
    font-size: 18px;
    color: var(--text-color);
    background-color: var(--card-bg);
    border-width: 1px;
    border-color: var(--card-border);
    border-radius: 4px;
    padding: 6px 10px;
    min-height: 38px;
    -unity-text-align: middle-center;
}

.mm-name-field:focus .unity-base-text-field__input {
    border-color: var(--accent);
}

/* Buttons */
.mm-button {
    height: 42px;
    margin: 10px 0 0 0;
    padding: 0;
    font-size: 17px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--text-color);
    background-color: var(--card-bg);
    border-width: 2px;
    border-color: var(--card-border);
    border-radius: 6px;
}

.mm-button:hover {
    background-color: var(--card-bg-hover);
}

.mm-button:active {
    background-color: rgba(5, 6, 8, 0.95);
}

.mm-button--primary {
    color: #1A1A1A;
    background-color: var(--accent);
    border-color: #F0C050;
}

.mm-button--primary:hover {
    background-color: #F0B030;
}

.mm-button--primary:active {
    background-color: #B88010;
}

.mm-button:disabled {
    opacity: 0.4;
}

/* Small text button under the others */
.mm-link {
    margin: 14px 0 0 0;
    padding: 2px;
    font-size: 13px;
    -unity-text-align: middle-center;
    color: var(--text-muted);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.mm-link:hover {
    color: var(--accent);
}

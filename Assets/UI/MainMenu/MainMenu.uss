/* Variables and font on the menu's own root so everything inherits them */
.main-menu-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: #0D0E12;
    --panel-bg: rgba(20, 22, 28, 0.95);
    --panel-border: #3A3F4B;
    --card-bg: rgba(10, 11, 14, 0.9);
    --card-bg-hover: rgba(40, 44, 54, 0.95);
    --card-border: #3A3F4B;
    --text-color: #F2F2F2;
    --text-muted: #A8ADB8;
    --accent: #E0A020;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/LiberationSans.ttf");
}

.mm-screen--hidden {
    display: none;
}

.mm-title {
    font-size: 56px;
    -unity-font-style: bold;
    color: var(--accent);
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0 0 32px 0;
}

.mm-panel {
    width: 380px;
    padding: 20px;
    background-color: var(--panel-bg);
    border-width: 2px;
    border-color: var(--panel-border);
    border-radius: 8px;
}

.mm-heading {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--text-color);
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0 0 14px 0;
}

.mm-hint {
    font-size: 12px;
    color: var(--text-muted);
    -unity-text-align: middle-center;
    white-space: normal;
    padding: 0;
    margin: 8px 0 4px 0;
}

/* Name field */
.mm-name-field {
    margin: 0;
    padding: 0;
    --unity-cursor-color: #F2F2F2;
    --unity-selection-color: rgba(224, 160, 32, 0.5);
}

.mm-name-field .unity-base-text-field__input {
    font-size: 18px;
    color: var(--text-color);
    background-color: var(--card-bg);
    border-width: 1px;
    border-color: var(--card-border);
    border-radius: 4px;
    padding: 6px 10px;
    min-height: 38px;
    -unity-text-align: middle-center;
}

.mm-name-field:focus .unity-base-text-field__input {
    border-color: var(--accent);
}

/* Buttons */
.mm-button {
    height: 42px;
    margin: 10px 0 0 0;
    padding: 0;
    font-size: 17px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--text-color);
    background-color: var(--card-bg);
    border-width: 2px;
    border-color: var(--card-border);
    border-radius: 6px;
}

.mm-button:hover {
    background-color: var(--card-bg-hover);
}

.mm-button:active {
    background-color: rgba(5, 6, 8, 0.95);
}

.mm-button--primary {
    color: #1A1A1A;
    background-color: var(--accent);
    border-color: #F0C050;
}

.mm-button--primary:hover {
    background-color: #F0B030;
}

.mm-button--primary:active {
    background-color: #B88010;
}

.mm-button:disabled {
    opacity: 0.4;
}

/* Small text button under the others */
.mm-link {
    margin: 14px 0 0 0;
    padding: 2px;
    font-size: 13px;
    -unity-text-align: middle-center;
    color: var(--text-muted);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.mm-link:hover {
    color: var(--accent);
}

.mm-link--danger:hover {
    color: #E05050;
}

/* Character Select */
.mm-panel--wide {
    width: 780px;
}

.cs-columns {
    flex-direction: row;
    min-height: 420px;
}

.cs-list-column {
    width: 300px;
}

.cs-detail-column {
    flex-grow: 1;
    margin-left: 20px;
    padding-left: 20px;
    border-left-width: 1px;
    border-color: var(--panel-border);
}

.cs-list {
    flex-grow: 1;
    max-height: 380px;
}

.cs-character {
    padding: 8px 10px;
    margin: 0 0 6px 0;
    background-color: var(--card-bg);
    border-width: 2px;
    border-color: var(--card-border);
    border-radius: 6px;
}

.cs-character:hover {
    background-color: var(--card-bg-hover);
}

.cs-character--selected {
    border-color: var(--accent);
}

.cs-character-name {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--text-color);
    padding: 0;
    margin: 0;
}

.cs-character-info {
    font-size: 12px;
    color: var(--text-muted);
    padding: 0;
    margin: 2px 0 0 0;
}

.cs-no-selection {
    margin-top: 40px;
}

.cs-view {
    flex-grow: 1;
}

.cs-spacer {
    flex-grow: 1;
}

.cs-detail-name {
    font-size: 28px;
    -unity-font-style: bold;
    color: var(--accent);
    padding: 0;
    margin: 0 0 8px 0;
}

.cs-detail-info {
    font-size: 15px;
    color: var(--text-color);
    padding: 0;
    margin: 0 0 4px 0;
}

.cs-label {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--text-muted);
    padding: 0;
    margin: 12px 0 6px 0;
}

.cs-label--first {
    margin-top: 0;
}

.cs-description {
    font-size: 12px;
    color: var(--text-muted);
    white-space: normal;
    padding: 0;
    margin: 2px 0 0 0;
}

.cs-error {
    font-size: 12px;
    color: #E05050;
    padding: 0;
    margin: 4px 0 0 0;
}

/* Class and resource choices, five to a row */
.cs-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.cs-choice {
    width: 18.8%;
    height: 32px;
    margin: 0 1% 6px 0;
    padding: 0;
    font-size: 13px;
    -unity-text-align: middle-center;
    color: var(--text-color);
    background-color: var(--card-bg);
    border-width: 1px;
    border-color: var(--card-border);
    border-radius: 4px;
}

.cs-choice:hover {
    background-color: var(--card-bg-hover);
}

.cs-choice--selected {
    color: var(--accent);
    -unity-font-style: bold;
    border-width: 2px;
    border-color: var(--accent);
}

.cs-row {
    flex-direction: row;
}

.cs-row-button {
    flex-grow: 1;
    flex-basis: 0;
}

.cs-row-button--gap {
    margin-left: 10px;
}

.cs-button--danger {
    color: #E05050;
    border-color: #E05050;
}

.cs-confirm-text {
    font-size: 14px;
    color: var(--text-color);
    -unity-text-align: middle-center;
    white-space: normal;
    padding: 0;
    margin: 12px 0 0 0;
}

<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="LeaderboardPanel.uss" />
    <ui:VisualElement name="leaderboardRoot" class="lb-root lb-root--hidden" picking-mode="Ignore">
        <ui:VisualElement name="panel" class="lb-panel">
            <ui:VisualElement class="lb-header">
                <ui:Label name="title" text="Leaderboard" class="lb-title" />
                <ui:Label name="closeButton" text="Close" class="lb-chip" />
            </ui:VisualElement>
            <!-- "New best!" after a finish -->
            <ui:Label name="note" class="lb-note" />
            <!-- One per player count, created by LeaderboardPanelHUD -->
            <ui:VisualElement name="tabs" class="lb-tabs" />
            <ui:VisualElement class="lb-row lb-row--headings">
                <ui:Label text="#" class="lb-cell lb-cell--heading lb-cell--rank" />
                <ui:Label text="Player" class="lb-cell lb-cell--heading lb-cell--name" />
                <ui:Label text="Difficulty" class="lb-cell lb-cell--heading lb-cell--difficulty" />
                <ui:Label text="Time" class="lb-cell lb-cell--heading lb-cell--time" />
                <ui:Label name="withHeading" text="Played with" class="lb-cell lb-cell--heading lb-cell--with" />
            </ui:VisualElement>
            <!-- Best first, created by LeaderboardPanelHUD -->
            <ui:ScrollView name="rows" class="lb-rows" />
            <ui:Label name="empty" class="lb-empty" />
            <ui:Label name="source" class="lb-hint" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

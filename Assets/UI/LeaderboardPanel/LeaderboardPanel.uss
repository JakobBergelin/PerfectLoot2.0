/* Variables and font on the panel's own root so everything inherits them. Same look as the Statistics panel. */
.lb-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    --panel-bg: rgba(20, 22, 28, 0.97);
    --panel-border: #3A3F4B;
    --row-bg: rgba(10, 11, 14, 0.6);
    --row-mine: rgba(224, 160, 32, 0.16);
    --chip-bg: #2A2E38;
    --chip-hover: #383D4A;
    --chip-border: #4A5060;
    --divider: #2C3039;
    --text-color: #F2F2F2;
    --text-muted: #A8ADB8;
    --accent: #E0A020;
    --best: #4CC94C;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/LiberationSans.ttf");
}

.lb-root--hidden {
    display: none;
}

.lb-panel {
    width: 860px;
    max-width: 96%;
    height: 640px;
    max-height: 96%;
    padding: 16px;
    background-color: var(--panel-bg);
    border-width: 2px;
    border-color: var(--panel-border);
    border-radius: 8px;
}

.lb-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
}

.lb-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--accent);
    padding: 0;
    margin: 0 0 0 4px;
}

.lb-note {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--best);
    padding: 0;
    margin: 0 0 6px 4px;
}

.lb-tabs {
    flex-direction: row;
    padding-bottom: 8px;
    margin-bottom: 6px;
    border-bottom-width: 1px;
    border-color: var(--divider);
}

/* Tabs and Close */
.lb-chip {
    padding: 5px 14px;
    margin: 0 6px 0 0;
    font-size: 14px;
    color: var(--text-muted);
    background-color: var(--chip-bg);
    border-width: 1px;
    border-color: var(--chip-border);
    border-radius: 4px;
}

.lb-chip:hover {
    background-color: var(--chip-hover);
    color: var(--text-color);
}

.lb-chip--selected {
    color: var(--text-color);
    border-color: var(--accent);
}

.lb-rows {
    flex-grow: 1;
}

.lb-row {
    flex-direction: row;
    align-items: center;
    min-height: 44px;
    padding: 2px 10px;
    margin-bottom: 3px;
    background-color: var(--row-bg);
    border-radius: 4px;
}

.lb-row--headings {
    background-color: transparent;
    min-height: 28px;
}

/* This player's own entry */
.lb-row--mine {
    background-color: var(--row-mine);
    border-width: 1px;
    border-color: var(--accent);
}

.lb-cell {
    font-size: 16px;
    color: var(--text-color);
    padding: 0;
    margin: 0;
    -unity-text-align: middle-left;
    white-space: normal;
}

.lb-cell--heading {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--text-muted);
}

.lb-cell--rank {
    width: 40px;
}

.lb-cell--name {
    width: 220px;
}

.lb-cell--difficulty {
    width: 90px;
    -unity-text-align: middle-right;
    margin-right: 20px;
}

.lb-cell--time {
    width: 100px;
    -unity-text-align: middle-right;
    margin-right: 20px;
}

.lb-cell--with {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 14px;
    color: var(--text-muted);
}

.lb-empty {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    font-size: 16px;
    color: var(--text-muted);
    -unity-text-align: middle-center;
}

.lb-hint {
    font-size: 12px;
    color: var(--text-muted);
    -unity-text-align: middle-center;
    padding: 0;
    margin: 8px 0 0 0;
}

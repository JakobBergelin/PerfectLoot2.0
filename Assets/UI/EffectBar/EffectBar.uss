/* Variables and font on the bar's own root so every tile inherits them */
.effect-bar-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    --tile-size: 44px;
    --tile-bg: rgba(20, 22, 28, 0.9);
    --buff-color: #4CC94C;
    --debuff-color: #E04848;
    --text-color: #F2F2F2;
    --text-muted: #A8ADB8;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/LiberationSans.ttf");
}

/* Just above the skill bar (24px padding + 88px slots + key labels) */
.effect-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 152px;
    flex-direction: row;
    justify-content: center;
}

.effect-bar__group {
    flex-direction: row;
    flex-wrap: wrap;
    width: 50%;
}

.effect-bar__group--buffs {
    justify-content: flex-end;
    padding-right: 12px;
}

.effect-bar__group--debuffs {
    justify-content: flex-start;
    padding-left: 12px;
}

.effect-tile {
    width: var(--tile-size);
    height: var(--tile-size);
    margin: 0 3px 6px 3px;
    background-color: var(--tile-bg);
    border-width: 2px;
    border-radius: 6px;
    overflow: hidden;
}

.effect-tile--buff {
    border-color: var(--buff-color);
}

.effect-tile--debuff {
    border-color: var(--debuff-color);
}

.effect-tile--hidden {
    display: none;
}

.effect-tile__icon {
    position: absolute;
    left: 3px;
    top: 3px;
    right: 3px;
    bottom: 3px;
    border-radius: 3px;
    -unity-background-scale-mode: scale-and-crop;
}

.effect-tile__fallback {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--text-color);
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
}

.effect-tile__sweep {
    --sweep-color: rgba(0, 0, 0, 0.6);
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.effect-tile__stacks {
    position: absolute;
    right: 2px;
    bottom: 0;
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--text-color);
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.9);
    padding: 0;
    margin: 0;
}

/* Effect tooltip */
.effect-tooltip {
    position: absolute;
    display: none;
    max-width: 280px;
    padding: 8px 10px;
    background-color: rgba(8, 9, 12, 0.97);
    border-width: 1px;
    border-color: #3A3F4B;
    border-radius: 4px;
}

.effect-tooltip--visible {
    display: flex;
}

.effect-tooltip__title {
    font-size: 15px;
    -unity-font-style: bold;
    padding: 0;
    margin: 0 0 4px 0;
}

.effect-tooltip__title--buff {
    color: var(--buff-color);
}

.effect-tooltip__title--debuff {
    color: var(--debuff-color);
}

.effect-tooltip__body {
    font-size: 13px;
    color: var(--text-color);
    white-space: normal;
    padding: 0;
    margin: 0;
}

.effect-tooltip__footer {
    font-size: 12px;
    color: var(--text-muted);
    padding: 0;
    margin: 6px 0 0 0;
}

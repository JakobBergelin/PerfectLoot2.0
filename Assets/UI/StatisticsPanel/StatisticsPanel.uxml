<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:Style src="StatisticsPanel.uss" />
    <ui:VisualElement name="statisticsRoot" class="stats-root stats-root--hidden" picking-mode="Ignore">
        <ui:VisualElement name="panel" class="stats-panel">
            <ui:VisualElement class="stats-header">
                <ui:Label text="Statistics" class="stats-title" />
                <!-- Account / character switch, created by StatisticsPanelHUD -->
                <ui:VisualElement name="scopes" class="stats-chips" />
            </ui:VisualElement>
            <!-- Tabs, created by StatisticsPanelHUD -->
            <ui:VisualElement name="tabs" class="stats-tabs" />
            <!-- Column headings (click to sort) and one row per stat or subject, created by StatisticsPanelHUD -->
            <ui:VisualElement name="headings" class="stats-row stats-row--headings" />
            <ui:VisualElement name="rows" class="stats-rows" />
            <ui:Label name="empty" text="Nothing yet" class="stats-empty" />
            <ui:Label text="Press O to close" class="stats-hint nav-mouse-only" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

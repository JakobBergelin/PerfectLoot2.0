/* Variables and font on the panel's own root so everything inherits them */
.skills-panel-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    --panel-bg: rgba(20, 22, 28, 0.95);
    --panel-border: #3A3F4B;
    --card-bg: rgba(10, 11, 14, 0.9);
    --card-bg-hover: rgba(40, 44, 54, 0.95);
    --card-border: #3A3F4B;
    --divider: #2C3039;
    --text-color: #F2F2F2;
    --text-muted: #A8ADB8;
    --accent: #E0A020;
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/LiberationSans.ttf");
}

.skills-panel-root--hidden {
    display: none;
}

.skills-panel {
    position: absolute;
    left: 24px;
    top: 24px;
    right: 24px;
    bottom: 24px;
    padding: 16px 20px;
    background-color: var(--panel-bg);
    border-width: 2px;
    border-color: var(--panel-border);
    border-radius: 8px;
}

.sp-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--accent);
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0 0 8px 0;
}

.sp-section-title {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--text-color);
    -unity-text-align: middle-center;
    padding: 0;
    margin: 4px 0 8px 0;
}

.sp-divider {
    height: 1px;
    margin: 12px 0 8px 0;
    background-color: var(--divider);
}

.sp-hint {
    font-size: 12px;
    color: var(--text-muted);
    -unity-text-align: middle-center;
    margin: 12px 0 0 0;
    padding: 0;
}

/* The page: slots on the left, the wheel in the middle, the highlighted skill's card on the right */
.sp-main {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
}

.sp-column {
    width: 320px;
    flex-shrink: 0;
    align-self: stretch;
    justify-content: center;
}

.sp-wheel-holder {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.sp-card-holder {
    width: 380px;
    flex-shrink: 0;
    height: 640px;
}

/* Active skill slots: a column of cards */
.sp-active-slots {
    flex-direction: column;
}

.sp-card {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
    padding: 6px;
    background-color: var(--card-bg);
    border-width: 2px;
    border-color: var(--card-border);
    border-radius: 6px;
}

.sp-card:hover {
    background-color: var(--card-bg-hover);
}

.sp-card--selected {
    border-color: var(--accent);
}

/* A skill is waiting for a slot: every slot invites a click */
.sp-card--choose {
    border-color: #F0C050;
    background-color: rgba(60, 50, 20, 0.9);
}

.sp-card__icon {
    width: 52px;
    height: 52px;
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0.5);
    -unity-background-scale-mode: scale-and-crop;
}

.sp-card__text {
    flex-grow: 1;
    flex-shrink: 1;
    margin-left: 10px;
}

.sp-card__name {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--text-color);
    padding: 0;
    margin: 0;
}

.sp-card__key {
    align-self: flex-start;
    margin-top: 4px;
    padding: 1px 6px;
    font-size: 12px;
    color: var(--accent);
    border-width: 1px;
    border-color: var(--card-border);
    border-radius: 3px;
}

/* Passive skill slots: a row of round icons */
.sp-passive-slots {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
}

.sp-passive {
    width: 100px;
    align-items: center;
    padding: 6px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 6px;
}

.sp-passive:hover {
    background-color: var(--card-bg-hover);
}

.sp-passive--selected {
    border-color: var(--accent);
}

.sp-passive__icon {
    width: 64px;
    height: 64px;
    border-radius: 32px;
    border-width: 2px;
    border-color: var(--card-border);
    background-color: rgba(0, 0, 0, 0.5);
    -unity-background-scale-mode: scale-and-crop;
}

.sp-passive__name {
    font-size: 13px;
    color: var(--text-color);
    white-space: normal;
    -unity-text-align: middle-center;
    margin: 6px 0 0 0;
    padding: 0;
}

/* The class passive, after the slots: a gold ring and a "Class" tag; it can't be changed */
.sp-passive--class {
    border-radius: 0;
}

.sp-passive--class:hover {
    background-color: rgba(0, 0, 0, 0);
}

.sp-passive--class .sp-passive__icon {
    border-color: var(--accent);
}

.sp-passive__class-tag {
    font-size: 11px;
    color: var(--accent);
    margin: 2px 0 0 0;
    padding: 0;
}

/* Picker with the skills that can go in the selected slot */
.sp-picker {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 4px;
    padding: 8px;
    background-color: rgba(0, 0, 0, 0.35);
    border-radius: 6px;
}

.sp-picker--hidden {
    display: none;
}

.sp-option {
    width: 96px;
    align-items: center;
    padding: 6px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 6px;
}

.sp-option:hover {
    background-color: var(--card-bg-hover);
}

.sp-option--current {
    border-color: var(--accent);
}

.sp-option__icon {
    width: 48px;
    height: 48px;
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0.5);
    -unity-background-scale-mode: scale-and-crop;
}

.sp-option__name {
    font-size: 12px;
    color: var(--text-color);
    white-space: normal;
    -unity-text-align: middle-center;
    margin: 4px 0 0 0;
    padding: 0;
}

.sp-picker__empty {
    font-size: 13px;
    color: var(--text-muted);
}

/* Skill tooltip */
.sp-tooltip {
    position: absolute;
    display: none;
    max-width: 280px;
    padding: 8px 10px;
    background-color: rgba(8, 9, 12, 0.97);
    border-width: 1px;
    border-color: var(--panel-border);
    border-radius: 4px;
}

.sp-tooltip--visible {
    display: flex;
}

.sp-tooltip__title {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--accent);
    padding: 0;
    margin: 0 0 4px 0;
}

.sp-tooltip__body {
    font-size: 13px;
    color: var(--text-color);
    white-space: normal;
    padding: 0;
    margin: 0;
}

/* The skill wheel (SkillWheel) */
.sw-wheel {
    flex-shrink: 0;
}

.sw-attribute {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--text-color);
    padding: 0;
    margin: 0;
}

.sw-ring-label {
    font-size: 10px;
    color: var(--text-muted);
    padding: 0;
    margin: 0;
}

/* A skill on the wheel: its icon, its name under it; left/top are set from code */
.sw-node {
    position: absolute;
    width: 40px;
    height: 40px;
    border-width: 2px;
    border-radius: 6px;
    border-color: var(--card-border);
    background-color: var(--card-bg);
}

.sw-node__icon {
    flex-grow: 1;
    -unity-background-scale-mode: scale-to-fit;
}

.sw-node--usable {
    border-color: #1D9E75;
}

.sw-node--locked .sw-node__icon {
    -unity-background-image-tint-color: #5A5A5A;
}

.sw-node--locked {
    opacity: 0.6;
}

.sw-node--equipped {
    border-color: var(--accent);
}

.sw-node--highlighted, .sw-node:hover {
    border-color: #F0C050;
    background-color: var(--card-bg-hover);
}

/* The skill waiting for a slot */
.sw-node--pending {
    border-color: #FFFFFF;
    border-width: 3px;
}

.sw-node__name {
    position: absolute;
    top: 40px;
    left: -24px;
    width: 84px;
    font-size: 10px;
    color: var(--text-color);
    white-space: normal;
    -unity-text-align: upper-center;
    padding: 0;
    margin: 0;
}

/* The key of the slot the skill is in */
.sw-node__badge {
    position: absolute;
    right: -10px;
    top: -10px;
    font-size: 10px;
    -unity-font-style: bold;
    color: #1A1A1A;
    background-color: var(--accent);
    border-radius: 3px;
    padding: 0 3px;
    margin: 0;
}

/* The highlighted skill's card: a fixed size, its tooltip scrolls */
.sw-card {
    height: 100%;
    padding: 10px 12px;
    background-color: var(--card-bg);
    border-width: 1px;
    border-color: var(--card-border);
    border-radius: 6px;
}

.sw-card__name {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--accent);
    padding: 0;
    margin: 0;
}

.sw-card__spoke {
    font-size: 12px;
    color: var(--text-muted);
    padding: 0;
    margin: 0 0 8px 0;
}

.sw-card__status {
    display: none;
    font-size: 13px;
    -unity-font-style: bold;
    color: #F0C050;
    padding: 0;
    margin: 0 0 8px 0;
}

.sw-card__unlock {
    font-size: 12px;
    color: var(--text-muted);
    white-space: normal;
    padding: 0;
    margin: 6px 0 0 0;
}

.sw-card__scroll {
    flex-grow: 1;
    flex-shrink: 1;
    margin-top: 8px;
    padding-top: 8px;
    border-top-width: 1px;
    border-color: var(--divider);
}

.sw-card__body {
    font-size: 12px;
    color: var(--text-color);
}

.sw-bar {
    margin-bottom: 4px;
}

.sw-bar__text {
    flex-direction: row;
    justify-content: space-between;
}

.sw-bar__label, .sw-bar__have {
    font-size: 12px;
    padding: 0;
    margin: 0;
}

.sw-bar--met .sw-bar__label, .sw-bar--met .sw-bar__have {
    color: #7FD07F;
}

.sw-bar--short .sw-bar__label, .sw-bar--short .sw-bar__have {
    color: #E05050;
}

.sw-bar__track {
    height: 5px;
    margin-top: 2px;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.08);
}

.sw-bar__fill {
    height: 5px;
    border-radius: 3px;
    background-color: #1D9E75;
}

.sw-bar--short .sw-bar__fill {
    background-color: #D85A30;
}

/* Stances: its card's border in the current stance's attribute colour */
.sp-card--stance-str {
    border-color: #E05050;
}

.sp-card--stance-agi {
    border-color: #50C878;
}

.sp-card--stance-int {
    border-color: #4A90E2;
}
